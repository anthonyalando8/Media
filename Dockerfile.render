FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    wget \
    curl \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --upgrade --force-reinstall yt-dlp

# Copy application code
COPY . .

# Copy supervisor configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create directories with proper permissions
RUN mkdir -p /app/media /app/staticfiles /tmp/media && \
    chmod -R 777 /app/media /tmp/media && \
    chmod -R 755 /app/staticfiles

# Collect static files
RUN python manage.py collectstatic --noinput || true

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-10000}/api/health/ || exit 1

EXPOSE 10000

# Start supervisor
CMD ["sh", "-c", "mkdir -p /tmp/media && chmod 777 /tmp/media && supervisord -c /etc/supervisor/conf.d/supervisord.conf"]